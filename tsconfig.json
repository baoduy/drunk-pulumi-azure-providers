{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./.out-bin",
    "target": "ESNext",
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "inlineSourceMap": true,
    "skipLibCheck": true,
    "stripInternal": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strict": true
  },
  "exclude": [
    "node_modules",
    "pulumi-test",
    "z_tests",
    ".out-bin",
    ".tools",
    "**/*.test.ts"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
