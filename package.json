{
  "name": "@drunk-pulumi/azure-providers",
  "version": "0.0.1",
  "author": "drunkcoding@outlook.com",
  "description": "The custom dynamic providers for pulumi-azure",
  "license": "MIT",
  "private": false,
  "keywords": [
    "pulumi-azure",
    "dynamic providers"
  ],
  "pulumi": {
    "resource": false,
    "name": "@drunk-pulumi/azure-providers"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/baoduy/drunk-pulumi-azure-providers.git"
  },
  "scripts": {
    "fastBuild": "tsc",
    "build": "pnpm run fastBuild && pnpm run copy-pkg",
    "copy-pkg": "tsx ./.tasks/npm-package.ts && cpy README.md .out-bin/",
    "pack": "cd .out-bin && pnpm pack && cd ../",
    "update": "npx npm-check-updates -u && pnpm install",
    "check": "npx depcheck --detailed",
    "test-leak": "cross-env PULUMI_DEBUG_PROMISE_LEAKS=true NODE_OPTIONS='--import tsx' TSX_TSCONFIG_PATH='./tsconfig.test.json' mocha --timeout 60000 'z_tests/**/*.test.ts'",
    "test": "cross-env NODE_OPTIONS='--import tsx' TSX_TSCONFIG_PATH='./tsconfig.test.json' mocha --timeout 60000 'z_tests/**/*.test.ts'",
    "lint": "eslint src --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pulumi/pulumi": "^3.253.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/node-forge": "^1.3.14",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "lint-staged": "^17.0.8",
    "mocha": "^11.7.6",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "dependencies": {
    "@azure/arm-apimanagement": "^10.0.0",
    "@azure/arm-cdn": "^9.1.0",
    "@azure/arm-compute": "^24.1.0",
    "@azure/arm-containerservice": "^25.3.0",
    "@azure/arm-keyvault": "^5.0.0",
    "@azure/arm-mysql-flexible": "^3.1.0",
    "@azure/arm-network": "^37.0.0",
    "@azure/arm-postgresql-flexible": "^9.0.0",
    "@azure/arm-sql": "^11.0.0",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-certificates": "^4.10.3",
    "@azure/keyvault-keys": "^4.10.2",
    "@azure/keyvault-secrets": "^4.11.2",
    "node-forge": "^1.4.0",
    "openpgp": "^6.3.1"
  },
  "peerDependencies": {
    "@pulumi/pulumi": "^3.0.0"
  },
  "prettier": {
    "singleQuote": true
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "main": "index.js",
  "types": "index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.8.0"
}
